! Unaveraged-mode coupling probe, HELICAL, long: identical to
! unavg_probe_helical_a.bmad except 20 periods instead of 12. See the planar _a
! header for the differential-measurement design.

no_digested
parameter[geometry] = open
parameter[particle] = electron
parameter[e_tot] = 11357.82 * m_electron

beginning[beta_a] = 8.53711
beginning[alpha_a] = -0.703306
beginning[beta_b] = 17.3899
beginning[alpha_b] = 1.40348

UNDH: wiggler, l = 0.30, l_period = 0.015, field_calc = helical_model, &
      b_max = 0.84853 * (twopi / 0.015) * m_electron / c_light, &
      tracking_method = custom, ds_step = 0.015

SEG1: line = (UNDH)

use, SEG1
