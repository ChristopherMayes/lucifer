! Unaveraged-mode example: the FEL with NO period averaging -- the particles ride the
! real undulator field, quiver and all, and the coupling the averaged map assumes is
! simply what happens (fel-physics.tex sec:unaveraged).
!
!   fel_track_test run.nml           (run from this directory; ~1 min)
!
! One seeded steady-state segment of the benchmark line. The run writes the usual
! diag file PLUS unaveraged.ledger.txt -- the energy ledger: beam energy (relative to
! the reference) and window field energy per record, whose sum is conserved to ~1e-5
! of the turnover (the kick and the source are exact duals; manual eq:ledger).
!
! The verification story: run run_averaged.nml (identical except
! und_transport = "genesis") and compare the two gain curves -- they agree to ~3e-3
! ln at the exit, the measured price of ramps + splitting between two INDEPENDENT
! formulations of the same physics. That agreement is what pins the averaged mode's
! coupling factor; the harness measures it precisely (fc to ~6e-4, README).

&fel_track_params
  lat_file = "seg1.bmad"
  out_root = "unaveraged"

  und_transport = "unaveraged"
  unavg_steps_per_period = 20  ! Substeps per undulator period (10 floor, 20-30 typical).
  unavg_ramp_periods = 2       ! sin^2 entry/exit ramps; the handoff happens at their ends.

  lambda0 = 1e-10              ! 1 Angstrom, resonant with the lattice undulator at 5.8 GeV.

  gen_current = 3000           ! 3 kA slice current.
  gen_delgam = 1.0             ! One electron rest mass of rms energy spread.
  gen_ex = 4e-7, gen_ey = 4e-7 ! 0.4 um normalized emittance.
  gen_beta_x = 8.53711,  gen_alpha_x = -0.703306
  gen_beta_y = 17.3899,  gen_alpha_y = 1.40348
  gen_power = 5e3              ! 5 kW seed...
  gen_waist_size = 30e-6       ! ...with a 30 um waist at the entrance.
  gen_ngrid = 129              ! Field grid (129 keeps the run around a minute;
  gen_dgrid = 2e-4             !   the physics gates use the same size).
&end
