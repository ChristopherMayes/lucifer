! Unaveraged-mode example: the FEL with NO period averaging -- the particles ride the
! real undulator field, quiver and all, and the coupling the averaged map assumes is
! simply what happens (fel-physics.tex sec:unaveraged).
!
!   fel_track_test run.nml           (run from this directory; ~1 min)
!
! One seeded steady-state segment of the benchmark line. The unaveraged mode is
! seg1.bmad's OWN attribute (fel_tracking = 1; steps/period and ramps default to
! 20 and 2 -- override per element with fel_steps_per_period / fel_ramp_periods). The run writes the usual
! diag file PLUS unaveraged.ledger.txt -- the energy ledger: beam energy (relative to
! the reference) and window field energy per record, whose sum is conserved to ~1e-5
! of the turnover (the kick and the source are exact duals; manual eq:ledger).
!
! The verification story: run run_averaged.nml (identical, with the element's
! fel_tracking overridden back to the averaged default) and compare the two gain
! curves -- they agree to ~8e-4 ln at the exit, the measured price of ramps +
! splitting between two INDEPENDENT formulations of the same physics. That agreement is what pins the averaged mode's
! coupling factor; the harness measures it precisely (fc to ~6e-4, README).

&fel_track_params
  lat_file = "seg1.bmad"
  out_root = "unaveraged"

  lambda0 = 1e-10              ! 1 Angstrom, resonant with the lattice undulator at 5.8 GeV.

  beam_init%n_particle = 2048
  beam_init%bunch_charge = 1.000692285594e-15  ! 3 kA: I = Q*c/spacing at sig_z = 0.
  beam_init%sig_z = 0                      ! Steady state.
  beam_init%sig_pz = 8.804506566858e-5     ! delta_gamma = 1.0 m_e c^2.
  beam_init%a_norm_emit = 4e-7
  beam_init%b_norm_emit = 4e-7

  seed_power = 5e3             ! 5 kW seed...
  seed_waist_size = 30e-6      ! ...with a 30 um waist at the entrance.
  grid_n_pts = 129             ! Field grid (129 keeps the run around a minute;
  grid_half_width = 2e-4       !   the physics checks use the same size).
  write_diag = T          ! the two-formulation overlay compares diag files.
&end
