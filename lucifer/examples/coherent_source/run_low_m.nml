! Steady-state FEL example: one command, no Genesis anywhere.
!
!   fel_track_test run.nml           (run from this directory)
!
! The program generates its own starting condition -- a quiet-start beam slice and a
! Gaussian seed field -- and tracks it through the 6-FODO helical undulator line of
! aramis.bmad (the Benchmark1-SASE configuration: 5.8 GeV, 1 Angstrom, aw = 0.85 rms).
! ../README.md's steady_state section has what to expect; plot with
!   python ../plot_fel.py steady_state.stats.h5
!
! The beam is described by Bmad's standard beam_init block (the Twiss comes from the
! lattice beginning element). The current is DERIVED, never input: sig_z = 0 is the
! steady state -- the whole charge in the one slice window, I = Q*c/slice_spacing --
! so bunch_charge below encodes 3 kA exactly.

&fel_params
  lat_file = "../aramis.bmad"
  global%out_root = "low_m"
/

&fel_beam_init

  beam_init%n_particle = 512              ! Macroparticles per slice.
  beam_init%bunch_charge = 1.000692285594e-15  ! 3 kA: I = Q*c/spacing (spacing = lambda0).
  beam_init%sig_z = 0                      ! Steady state (one slice, refused for TD windows).
  beam_init%sig_pz = 8.804506566858e-5     ! delta_gamma = beta0*p0_mc*sig_pz = 1.0 m_e c^2.
  beam_init%a_norm_emit = 4e-7             ! 0.4 um normalized emittance.
  beam_init%b_norm_emit = 4e-7
/

&fel_wavefront_init

  wavefront_init%lambda0 = 1e-10              ! 1 Angstrom, resonant with the lattice undulator at 5.8 GeV.

  wavefront_init%seed_power = 5e3             ! 5 kW seed (Genesis &field power)...
  wavefront_init%seed_waist_size = 30e-6      ! ...with a 30 um waist at the entrance (&field waist_size).
  wavefront_init%grid_n_pts = 255             ! Field grid: 255 x 255 points (&field ngrid)...
  wavefront_init%grid_half_width = 2e-4       ! ...spanning +-0.2 mm (&field dgrid).
/
