! SASE with the chamber wake on the undulators via BMAD's wake machinery (z_long
! binned-FFT table, once per wiggler element over the whole window) -- the same
! physical kernel the wake_on model (sase_wake) convolves per step. See ../README.md's bmad_wake section
! for the two-implementation comparison and measured numbers.
!
!   lucifer run.nml           (run from this directory)
!   python ../plot_fel.py bmad_wake.stats.h5

&fel_params
  lat_file = "wake_lattice.bmad"
  global%out_root = "bmad_wake"
  global%ran_seed = 12345
/

&fel_beam_init
  beam_init%n_particle = 2048
  beam_init%bunch_charge = 2.881993782512e-13  ! 3 kA flat: I = Q*c/extent.
  beam_init%distribution_type(3) = "GRID"  ! Flat bunch (Bmad's uniform)...
  beam_init%grid(3)%x_min = -1.44e-8       ! ...spanning the full 96-slice window.
  beam_init%grid(3)%x_max =  1.44e-8
  beam_init%sig_pz = 8.804506566858e-5     ! delta_gamma = 1.0 m_e c^2.
  beam_init%a_norm_emit = 4e-7
  beam_init%b_norm_emit = 4e-7
  shot_noise = T
/

&fel_wavefront_init

  wavefront_init%lambda0 = 1e-10

  wavefront_init%seed_power = 0
  wavefront_init%grid_n_pts = 255
  wavefront_init%grid_half_width = 2e-4
  wavefront_init%window_length = 2.88e-8
  wavefront_init%window_sample = 3
/
