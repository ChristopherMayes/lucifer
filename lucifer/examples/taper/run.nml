! Tapered steady-state FEL example: steady_state/run.nml, but over taper.bmad, whose last
! two FODO cells use a second undulator definition with b_max 0.4% lower.
!
!   lucifer run.nml           (run from this directory)
!
! Same generated starting condition as the steady_state example, so the two gain curves
! are directly comparable: they separate where the taper begins (z = 31.92 m) and this
! one ends higher. Measured numbers are ../README.md's taper section; plot with
! ../plot_fel.py taper.stats.h5. The beam is the
! steady_state example's beam_init description (3 kA via I = Q*c/spacing at sig_z = 0).

&fel_params
  lat_file = "taper.bmad"
  global%out_root = "taper"
/

&fel_beam_init

  beam_init%n_particle = 8192
  beam_init%bunch_charge = 1.000692285594e-15  ! 3 kA: I = Q*c/spacing.
  beam_init%sig_z = 0                          ! Steady state.
  beam_init%sig_pz = 8.804506566858e-5         ! delta_gamma = 1.0 m_e c^2.
  beam_init%a_norm_emit = 4e-7
  beam_init%b_norm_emit = 4e-7
/

&fel_wavefront_init

  wavefront_init%lambda0 = 1e-10              ! 1 Angstrom, resonant with the lattice undulator at 5.8 GeV.

  wavefront_init%seed_power = 5e3
  wavefront_init%seed_waist_size = 30e-6
  wavefront_init%grid_n_pts = 255
  wavefront_init%grid_half_width = 2e-4
/
