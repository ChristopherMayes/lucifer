! Time-dependent SASE example: one command, no Genesis, no seed field, no dump files.
!
!   fel_track_test run.nml           (run from this directory)
!
! The program generates a 96-slice time window of quiet-start beam, imposes physical
! shot noise (weighted Fawley loading -- see the fel_track_test.f90 header), starts the
! field dark (seed_power = 0), and tracks the full 6-FODO helical line. The FEL grows
! from its own electron shot noise: pure SASE. Slippage is active; each slice lases
! independently and the per-slice power spread is the SASE fluctuation. Measured
! behavior is ../README.md's sase section; plot with ../plot_fel.py sase.stats.h5.
!
! The beam is a FLAT (coasting) bunch, described in Bmad's own vocabulary:
! distribution_type(3) = "GRID" (Bmad's uniform) over the window extent, with the
! current DERIVED as I = Q*c/extent -- bunch_charge below encodes 3 kA exactly.

&fel_params
  lat_file = "../aramis.bmad"
  global%out_root = "sase"

  ! Diagnostics (manual sec:stats). The stats file <out_root>.stats.h5 is always
  ! written. Uncomment to also dump at named elements and bank the escaped field
  ! (full pulse reconstructed at the exit as <out_root>-pulse.fld.h5):
  ! global%dump_beam_at = "UND3"
  ! global%dump_field_at = "UND3"
  ! global%keep_escaped_field = T
  ! Spontaneous radiation (Bmad's global switches; off by default, like Genesis's
  ! &sponrad). At 1 Angstrom the loss is ~0.5 rho of detuning over the full line:
  ! bmad_com%radiation_damping_on = T
  ! bmad_com%radiation_fluctuations_on = T
/

&fel_beam_init

  beam_init%n_particle = 2048              ! Macroparticles per slice.
  beam_init%bunch_charge = 2.881993782512e-13  ! 3 kA flat: I = Q*c/extent.
  beam_init%distribution_type(3) = "GRID"  ! Flat bunch (Bmad's uniform)...
  beam_init%grid(3)%x_min = -1.44e-8       ! ...spanning the full 96-slice window.
  beam_init%grid(3)%x_max =  1.44e-8
  beam_init%sig_pz = 8.804506566858e-5     ! delta_gamma = 1.0 m_e c^2.
  beam_init%a_norm_emit = 4e-7
  beam_init%b_norm_emit = 4e-7
  shotnoise = T
/

&fel_wavefront_init

  wavefront_init%lambda0 = 1e-10              ! 1 Angstrom.

  wavefront_init%seed_power = 0               ! Dark start: SASE from shot noise alone.
  wavefront_init%grid_n_pts = 255
  wavefront_init%grid_half_width = 2e-4

  wavefront_init%window_length = 2.88e-8      ! 96 slices (&time slen)...
  wavefront_init%window_sample = 3            ! ...of spacing 3*lambda0, slippage one slice per step.
/
