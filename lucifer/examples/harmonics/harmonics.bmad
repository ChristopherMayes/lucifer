! Harmonic-lasing example lattice: one planar undulator segment at the benchmark
! energy and rms aw (planar, so the odd-harmonic couplings fc(h) are alive -- a
! helical device couples only the fundamental). Resonant at 1 Angstrom; the third
! harmonic radiates at 1/3 Angstrom. Production defaults: Bmad's own kernel maps
! (fel_tracking unset), ds_step = 3 periods.

no_digested
parameter[geometry] = open
parameter[particle] = electron
parameter[e_tot] = 11357.82 * m_electron

beginning[beta_a] = 15
beginning[beta_b] = 15

UNDP: wiggler, l = 3.96, l_period = 0.015, field_calc = planar_model, &
      b_max = sqrt(2) * 0.84853 * (twopi / 0.015) * m_electron / c_light, &
      tracking_method = custom, ds_step = 0.045

SEGP: line = (UNDP)

use, SEGP
