! Harmonic lasing, one command: a strongly seeded steady-state run on a planar
! segment carrying the fundamental AND a third-harmonic field (namelist harmonics).
! The harmonic starts dark and grows from the bunching the fundamental drives --
! nonlinear harmonic generation. Plot with:
!
!   python ../plot_fel.py harmonics.stats.h5
!
! and read the harmonic panel: each harmonic's power against the fundamental's.
! The stats file carries the harmonic's full wavefront_params under field/harm3/.

&fel_params
  lat_file = "harmonics.bmad"
  global%out_root = "harmonics"
  global%ran_seed = 12345

  global%wavefront_formats = 'genesis', 'openpmd'  ! Genesis dumps AND openPMD (.wf.h5).
/

&fel_beam_init

  beam_init%n_particle = 8192
  beam_init%bunch_charge = 1.000692285594e-15   ! 3 kA (I = Q*c/spacing, SS).
  beam_init%sig_z = 0                           ! Steady state.
  beam_init%sig_pz = 8.804506566858e-5
  beam_init%a_norm_emit = 4e-7
  beam_init%b_norm_emit = 4e-7
/

&fel_wavefront_init

  wavefront_init%lambda0 = 1e-10
  wavefront_init%harmonics = 1, 3             ! The field set: fundamental + third harmonic.

  wavefront_init%seed_power = 2e8             ! Hard seed: reach the nonlinear regime inside 4 m.
  wavefront_init%seed_waist_size = 30e-6
  wavefront_init%grid_n_pts = 151
  wavefront_init%grid_half_width = 2e-4
/
