# Build output. util/conda_compile builds into build-debug and build-release at the root,
# and any build-* directory is a build. Digested lattices are Bmad's parse cache, written
# beside the lattice.
build-*
*.mod
*.digested*

__pycache__
.DS_Store

# The Python package installed in place, and what building a wheel of it writes.
*.egg-info
python/build/
python/dist/
