&fel_params
  lat_file = "aramis_1seg.bmad"
  global%out_root = "sase_24x4096"
  global%comb_ds_save = -1
  slicing%window_length = 7.200000e-09
  slicing%n_wavelength = 3
/

&fel_beam_init
  beam_init%n_particle = 4096
  beam_init%bunch_charge = 2.881993782512e-13
  beam_init%distribution_type(3) = "GRID"
  beam_init%grid(3)%x_min = -3.600000e-09
  beam_init%grid(3)%x_max =  3.600000e-09
  beam_init%sig_pz = 8.804506566858e-5
  beam_init%a_norm_emit = 4e-7
  beam_init%b_norm_emit = 4e-7
  shot_noise = T
/

&fel_wavefront_init
  wavefront_init%lambda0 = 1e-10
  wavefront_init%seed_power = 0
  wavefront_init%grid_n_pts = 256
  wavefront_init%grid_half_width = 2e-4
/
